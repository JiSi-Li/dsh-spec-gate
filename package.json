{
  "name": "@local/dsh-spec-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spec-driven workflow with a hard gate: five stages, button-only confirmation, audit of denied writes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
